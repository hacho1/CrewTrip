{
  "name": "crewtrip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/src/index.ts",
    "build": "tsc --noEmit && vite build --config passenger-web/vite.config.ts",
    "start": "tsx server/src/index.ts",
    "test": "tsx --test server/test/*.test.ts",
    "test:e2e": "playwright test",
    "web:dev": "vite --config passenger-web/vite.config.ts --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.1.0",
    "hls.js": "^1.7.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  }
}
